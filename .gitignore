# 他社の資料（再配布の可否が不明なため、手元にだけ置く）
docs/references/**/*.pdf
docs/references/**/*.stp
docs/references/**/*.step
docs/references/**/*.zip
docs/references/**/*.dwg

# 3D モデル（他所の作者の配布物を含むため、手元にだけ置く。入手元は lib/3dmodels/README.md）
hardware/pcb/lib/3dmodels/*
!hardware/pcb/lib/3dmodels/README.md
# koktoh 氏のモデルは再配布が許可されているので含める（CC BY-NC-SA。koktoh/README.md 参照）
!hardware/pcb/lib/3dmodels/koktoh/
# 自作モデル（寸法図から起こしたもの。lib/3dmodels/README.md 参照）
!hardware/pcb/lib/3dmodels/8.8-DSI-TOUCH-A.step
!hardware/pcb/lib/3dmodels/Low Profile Keycap *.step
!hardware/pcb/lib/3dmodels/RaspberryPi_CM0.step
!hardware/pcb/lib/3dmodels/SW_Push_1P1T_XKB_TS-1187A.step
!hardware/pcb/lib/3dmodels/USB_C_Receptacle_HRO_TYPE-C-31-M-12.step
!hardware/pcb/lib/3dmodels/microSD_HRO_TF-01A.step

# KiCad の一時ファイルと個人の表示設定
*-backups/
_autosave-*
*.lck
~*.lck
fp-info-cache
*.kicad_prl
*.bak

# 基板から書き出した 3D（他社のモデルを含む。いつでも書き出し直せる）
hardware/pcb/skjar.step

# OS / エディタ
.DS_Store
Thumbs.db
desktop.ini
.vscode/
.idea/

# Python bytecode (make_case.py run under FreeCAD)
__pycache__/

# Rust のビルド結果
firmware/**/target/

# タッチ UI のビルド結果と、CMake が取ってくる依存（LVGL）
software/ui/build*/
software/ui/.deps/

# 隠し機能の動画（作品の著作権のため、リポジトリに入れない）
*.skm
movie.wav
*.mp4
