(version 1)

# JLCPCB 2-layer 1 oz capabilities that the board setup cannot express.
# https://jlcpcb.com/capabilities/pcb-capabilities (read 2026-11-01)

(rule "JLCPCB: PTH annular ring"
	(constraint annular_width (min 0.18mm))
	(condition "A.Type == 'Pad' && A.Pad_Type == 'Through-hole'"))

(rule "JLCPCB: pad hole to hole"
	(constraint hole_to_hole (min 0.45mm))
	(condition "A.Type == 'Pad' && B.Type == 'Pad'"))

(rule "JLCPCB: PTH to track"
	(constraint hole_clearance (min 0.28mm))
	(condition "A.Type == 'Pad' && A.Pad_Type == 'Through-hole' && B.Type == 'Track'"))

(rule "JLCPCB: SMD pad to pad"
	(constraint clearance (min 0.15mm))
	(condition "A.Type == 'Pad' && B.Type == 'Pad' && A.Net != B.Net"))

(rule "JLCPCB: pad to silkscreen"
	(constraint silk_clearance (min 0.15mm))
	(condition "A.Type == 'Pad' && B.Layer == '?.Silkscreen'"))

# GND pour: 0.5 mm from everything, except the GCPW pairs, which run 0.2 mm from it.
# The zone itself is set to 0.2 so that these rules decide. Dimensions: docs/design-decisions.md
(rule "GND pour clearance"
	(constraint clearance (min 0.5mm))
	(condition "A.Type == 'Zone' && A.NetName == 'GND' && B.NetClass != 'DSI' && B.NetClass != 'USB'"))

(rule "GCPW: pair to GND pour"
	(constraint clearance (min 0.2mm))
	(condition "A.Type == 'Zone' && A.NetName == 'GND' && (B.NetClass == 'DSI' || B.NetClass == 'USB')"))

# DSI: 0.75 mm (3 x width) between different pairs, except where the pairs fan into
# the 0.5 mm pitch pins of CM0 (U201) and J301. P to N stays at the netclass gap (0.2 mm).
(rule "DSI: pair to pair"
	(constraint clearance (min 0.75mm))
	(condition "A.NetClass == 'DSI' && B.NetClass == 'DSI' && !A.isCoupledDiffPair() && !A.intersectsCourtyard('U201') && !B.intersectsCourtyard('U201') && !A.intersectsCourtyard('J301') && !B.intersectsCourtyard('J301')"))

# DSI: P and N of each pair within 0.15 mm of each other.
(rule "DSI: P/N skew"
	(constraint skew (max 0.15mm) (within_diff_pairs))
	(condition "A.NetClass == 'DSI'"))
