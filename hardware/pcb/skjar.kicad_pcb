	(footprint "Skjar:Waveshare_8.8-DSI-TOUCH-A_Studs"
		(layer "F.Cu")
		(uuid "49236b45-0723-43f9-9165-abffb9ada9b4")
		(at 148.43125 51.275)
		(descr "Clearance holes for the back studs of the Waveshare 8.8-DSI-TOUCH-A (the panel is screwed to the case). The holes leave at least 0.5 mm all round: the four outer ones are 5.2 mm; the four inner ones are 6.5 x 10.5 mm slots that also take the Raspberry Pi pattern standoffs (5.5 mm) of the 8.8inch DSI LCD. Origin at the glass centre, seen from the front. From the Waveshare 2D drawing (2025-12-15) and STEP. F.Fab: the glass, the studs, the connector window and its DSI and 5V connectors.")
