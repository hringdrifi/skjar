# SKJÁR touch UI (software/ui) on tty1. Draws straight to the framebuffer, no X / Wayland.
#
# The UI is keyboard mode (physical keys go to the PC). Leaving it (System tab > Open console) is
# cyberdeck mode: the UI exits and tty1 gets its login console back. Typing `skjar` there starts
# the UI again (software/os/bin/skjar).
#
#   skjar-ui@boot.service    started at power-on: shows the UI only if a PC is connected,
#                            otherwise goes straight to the console
#   skjar-ui@manual.service  started by `skjar`: if no PC is connected, asks to connect one
#
# Install:
#   sudo cp skjar-ui@.service /etc/systemd/system/
#   sudo cp ../bin/skjar /usr/local/bin/ && sudo chmod +x /usr/local/bin/skjar
#   sudo systemctl disable serial-getty@ttyS0.service    # the UART belongs to the UI
#   sudo systemctl enable skjar-ui@boot.service
#
# getty@tty1 stays enabled: it runs whenever the UI is not on tty1. Console autologin
# (raspi-config > System Options > Boot / Auto Login) saves logging in after each switch.
#
# It runs as root for now: it opens /dev/fb0, /dev/input/event*, /dev/serial0, writes the
# backlight in /sys and calls poweroff. A dedicated user is a later step (software/ui/README.md).

[Unit]
Description=SKJAR touch UI (%i)
After=systemd-user-sessions.service
# The UI takes tty1 from the login console while it runs
Conflicts=getty@tty1.service
Before=getty@tty1.service
# Give up after 5 starts in 60 s (the default 5 in 10 s is never reached: a restart plus the UI's own
# start-up take 2-3 s), so a UI that keeps crashing leaves tty1 to the login console. The RP2040 then
# sends the keys to the console, because the UI's ALIVE stops (docs/protocol.md, 2.6).
StartLimitIntervalSec=60
StartLimitBurst=5

[Service]
ExecStart=/usr/local/bin/skjar-ui --start %i
# Whenever the UI stops, tty1 goes back to the login console. After a crash the UI is started again a
# second later and takes tty1 back; the RP2040 keeps the keys on the PC as long as the UI's ALIVE stops
# for less than its timeout (3 s; the UI starts in about 0.9 s on a Zero 2 W), so the console only flickers.
ExecStopPost=/bin/systemctl --no-block start getty@tty1.service
Restart=on-failure
RestartSec=1
# The UI tells systemd it is alive every second from its drawing loop (WATCHDOG=1 on $NOTIFY_SOCKET).
# If it hangs, systemd stops it and starts it again.
WatchdogSec=5
NotifyAccess=main

[Install]
WantedBy=multi-user.target
